 "transformer": {
  "arm_id": "seq_transformer",
  "label": "Transformer (causal encoder over daily tokens)",
  "family": "attn",
  "family_label": "Attention and transformers",
  "released": "TBD",
  "assumption": "Any earlier day can be looked up directly. Each day's output is built from learned weighted averages (attention) over all earlier days of the 730-day window, the weights set by content and by a sinusoidal position encoding. There is no built-in store that fills and drains and no built-in fading of memory: memory is a lookup, not an integrator. Causal mask: day t attends to days <= t only.",
  "core": "Linear 29 -> 32, + sinusoidal position encoding (positions 0-729), 3 pre-LayerNorm blocks of causal multi-head self-attention (4 heads of size 8; 2 heads of size 16 in r3) and a GELU feed-forward layer (64), final LayerNorm, dropout 0.1 before the head. r2 (rejected) used causal 7-day patches instead of daily tokens.",
  "rungs": [
   {
    "id": "r0",
    "change": "base: daily tokens, FlowCast's training recipe (3000 steps)",
    "decision": "base",
    "why": "first rung; learns slowly (quick val 0.30 / 0.34 / 0.39 at 1k / 2k / 3k steps vs the LSTM's 0.38 / 0.40 / 0.45)."
   },
   {
    "id": "r1",
    "change": "2x training: 6000 steps",
    "decision": "kept",
    "why": "sim +0.037 over r0 and dev 0.389 >= 0.95 x 0.362: kept."
   },
   {
    "id": "r2",
    "change": "causal 7-day patches (105 tokens, 2 blocks): each day reads the attention output of all earlier complete weeks + a depthwise causal conv over its own last 7 days; 25.8k parameters; 6000 steps",
    "decision": "rejected",
    "why": "sim 0.341 vs incumbent r1 0.401: weekly tokens lose more than they save (10x cheaper per step)."
   },
   {
    "id": "r3",
