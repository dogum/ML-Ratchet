  .mf .tm tr.tot td.zero { color: var(--loss); }
  .mf .acc { display: inline-block; width: 9px; height: 9px; border-radius: 2px; flex: none; }
  .mf .mdetail { padding: 20px 22px; display: grid; gap: 12px; }
  .mf .mdetail h3 { font-size: 34px; line-height: 1; }
  .mf .mdetail h3 a { text-decoration: none; }
  .mf .mdetail dl { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 8px 14px; margin: 0; font-size: 14px; }
  .mf .mdetail dt { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); padding-top: 3px; }
  .mf .mdetail dd { margin: 0; overflow-wrap: anywhere; }
  .mf .ideas { display: grid; gap: 8px; }
  .mf .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--ink-2); margin: 0; }
  .mf .legend span { display: inline-flex; align-items: center; gap: 6px; }
