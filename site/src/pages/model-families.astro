  .mf .stats { display: grid; grid-template-columns: repeat(5, 1fr); margin: 28px 0 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .mf .stats div { padding: 14px 16px 16px 0; border-right: 1px solid var(--rule); min-width: 0; }
