  .mf .sec { padding-top: clamp(56px, 8vw, 96px); scroll-margin-top: 110px; display: grid; gap: 20px; }
  .mf .sec > * { min-width: 0; }
  .mf .sec-head { max-width: 72ch; }
  .mf .sec-head .section { margin: 10px 0 14px; }
  .mf .sec-head .section em { color: var(--ink-2); }
  .mf .sec-head p.muted { margin: 0; }
  .mf .pad { padding: clamp(16px, 2.5vw, 26px); }
  .mf .h3 { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.05; }
  .mf .small { font-size: 14.5px; }
