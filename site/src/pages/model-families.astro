  .mf-toc { position: sticky; top: 60px; z-index: 20; margin-top: 36px; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
