  :root[data-theme='dark'] { --f-sig: #5cc3f0; --f-tab: #b8cc4a; --f-struct: #b69cff; --f-dist: #ff7aa8; --f-phys: #3cc9b9; }

  /* the site sets no global rule for [hidden], and the display rules below would otherwise override it */
