---
// Mental models: where this collection sits among other ways to combine physics and ML, where physics enters each
// model, eight lenses for holding the method in mind, and where the no-real-training-data line could move.
// Copy and diagram data: src/lib/mental-models.ts. Numbers come from model.yaml / ratchet.yaml at build time.
import Base from '../layouts/Base.astro';
import LadderChart from '../components/LadderChart.astro';
import RatchetMachine from '../components/RatchetMachine.astro';
import WiringDiagram from '../components/mental-models/WiringDiagram.astro';
import Lenses from '../components/mental-models/Lenses.astro';
import RealDataDial from '../components/mental-models/RealDataDial.astro';
import Exam2Chart from '../components/mental-models/Exam2Chart.astro';
import { APPROACHES, GUESS_DIFF, LENSES, STOPS, NODE_INFO, EDGE_INFO, NEIGHBOURS, REJECT_LABEL, rejectReason, type Explainer, type RejectReason } from '../lib/mental-models';
import { collectionStats, getModels, getModel, ghFile, type ExamRow, type RealDataRole } from '../lib/data';
import { url } from '../lib/url';

const s = collectionStats();
const models = getModels();
const quake = getModel('quakenet')!;
const qr = (id: string) => quake.ladders[0].rungs.find((r) => r.id === id)?.sim?.toFixed(3) ?? '—';
const qDistRow = quake.exam.results.find((r) => /^Distance/.test(r.metric));

// EnergyNet's exam rows that carry a regression fitted on real EPA tests: the repo's own black-box baseline
const energy = getModel('energynet')!;
const regRows = energy.exam.results.filter((r) => r.baselines.some((b) => b.name.startsWith('Log-linear regression')));
const short = (r: ExamRow) => r.metric.replace(/^EPA /, '').replace(/\s*\(.*$/, '').replace(/ tests$/, '');
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const regWins = regRows.filter((r) => r.verdict === 'loss');
const regLoses = regRows.filter((r) => r.verdict === 'win');
const pct = (v: number | string) => (typeof v === 'number' ? v.toFixed(1) : v);
const regVal = (r: ExamRow) => pct(r.baselines.find((b) => b.name.startsWith('Log-linear regression'))!.value);
const hwy = regRows.find((r) => /petrol highway/i.test(r.metric));
const petrolLoss = hwy ? `EnergyNet’s EPA petrol highway row (${pct(hwy.model)}% against the regression’s ${regVal(hwy)}%)` : 'EnergyNet’s EPA petrol rows';
const anchored = models.filter((m) => m.approach?.physics_anchor).map((m) => m.name);

const fill = (t: string) => t
  .replace('{blackbox}', `On EnergyNet ${energy.version}’s exam, a log-linear regression fitted on real EPA tests plays this part. It beats the network on ${list(regWins.map(short))}, and loses on ${list(regLoses.map(short))}.`)
  .replace('{residual}', `${list(anchored)} already shape their output around a physics estimate (section 03), though they learn the correction from simulations. Training it on real data would be the next step along.`)
  .replace('{petrolLoss}', petrolLoss)
  .replace('{labels}', String(s.realTrainingLabels))
  .replace('{q1}', qr('r1')).replace('{q3}', qr('r3'))
  .replace('{rejected}', String(s.rejected))
  .replace('{q2}', qr('r2'))
  .replace('{qDist}', String(qDistRow?.model ?? '—')).replace('{qDistB}', String(qDistRow?.baselines[0]?.value ?? '—'))
  .replace('{enTrips}', energy.summary.match(/([\d,]+) simulated trips/)?.[1] ?? 'tens of thousands of')
  .replace('{enExam}', energy.split.exam.replace(/\.$/, ''));
const fillInfo = (m: Record<string, Explainer>) => Object.fromEntries(Object.entries(m).map(([k, v]) => [k, { d: fill(v.d), ex: v.ex && fill(v.ex) }]));
const nodeInfo = fillInfo(NODE_INFO), edgeInfo = fillInfo(EDGE_INFO);
const approaches = APPROACHES.map((a) => ({ ...a, repo: fill(a.repo) }));
const lenses = LENSES.map((z) => ({ ...z, evi: fill(z.evi), see: fill(z.see) }));
const stops = STOPS.map((x) => ({ ...x, gain: fill(x.gain) }));

// the grey-box table, generated from each model.yaml's approach block
const ROLE: Record<RealDataRole, string> = { backdrop: 'noise', calibration: 'calibrate', gate: 'gate', error_bars: 'error bars', exam: 'exam' };
const grey = models.map((m) => ({ id: m.id, name: m.name, accent: m.accent, a: m.approach }));
const count = (k: 'real_backdrop' | 'physics_inputs' | 'physics_anchor') => grey.filter((g) => g.a?.[k]).length;

// chip label: the model's name, then the ladder's own name without a repeated model name or a dated note in brackets
const ladderLabel = (mName: string, lName: string, many: boolean) => {
  let rest = lName.replace(/\s*\(.*\)$/, '').trim();
  if (rest.toLowerCase().startsWith(mName.toLowerCase())) rest = rest.slice(mName.length).replace(/^\s*[·—-]?\s*/, '');
  if (rest.length > 32 && rest.includes(' — ')) rest = rest.split(' — ')[0];
  return many && rest ? `${mName} · ${rest}` : mName;
};
// every rejected rung, with why it was rejected (the logged reason decides; the score delta is the fallback)
type AnyLadder = (typeof models)[number]['ladders'][number];
const rejections = (l: AnyLadder) => {
  let inc: number | null = null;
  const out: { id: string; why: string; reason: RejectReason; delta: number | null }[] = [];
  for (const r of l.rungs) {
    const delta = r.sim !== undefined && inc !== null ? r.sim - inc : null;
    if (r.decision === 'rejected') out.push({ id: r.id, why: r.why, reason: rejectReason(r.why, delta, l.margin), delta });
    else if (r.sim !== undefined) inc = r.sim;
  }
  return out;
};
// R1, R2, R3 -> R1–R3 when the ids are one prefix with consecutive numbers
const idRange = (ids: string[]) => {
  const p = ids.map((id) => id.match(/^(.*?)(\d+)$/));
  if (ids.length > 2 && p.every((x, k) => x && x[1] === p[0]![1] && (k === 0 || +x[2] === +p[k - 1]![2] + 1))) return `${ids[0]}–${ids[ids.length - 1]}`;
  return ids.join(', ');
};
const ladders = models.flatMap((m) => m.ladders.map((l, i) => {
  const rej = rejections(l);
  const groups = (['gate', 'margin', 'fell', 'rule'] as RejectReason[]).map((k) => ({ k, rungs: rej.filter((x) => x.reason === k) })).filter((g) => g.rungs.length);
  const gateUp = rej.filter((x) => x.reason === 'gate' && x.delta !== null && x.delta > l.margin);
  return { m, l, uid: `mm-${m.id}-${i}`, label: ladderLabel(m.name, l.name, m.ladders.length > 1), groups, gateUp };
}));
const startLadder = ladders.findIndex((x) => x.m.id === 'quakenet');

const toc = [
  ['first-guess', 'A first guess'], ['wiring', 'Where data flows'], ['grey-box', 'Physics-informed?'],
  ['ratchet', 'The ratchet'], ['worked-example', 'Worked example'], ['lenses', 'Eight lenses'], ['real-data', 'Real data, later'], ['neighbours', 'Neighbours'], ['many-ways', 'Many ways'],
];
---
<Base title="Mental models" description="Where ML Ratchet sits among other ways to combine physics and machine learning: the same boxes wired eleven ways, where physics enters each model, eight lenses, and where the no-real-training-data line could move." keywords={['physics-informed neural networks', 'domain randomization', 'surrogate model', 'Bayesian calibration', 'data assimilation', 'domain adaptation', 'transfer learning', 'grey-box modelling']}>
  <section class="hero wrap">
    <p class="kicker tick-label">Mental models · ways to think about this project</p>
    <h1 class="display h"><span class="real-t">Reality</span> teaches the simulator.<br /><em>The <span class="sim-t">simulator</span> teaches the network.</em></h1>
    <p class="lead muted">
      That sentence sums up the method. Real data is used at every stage here. It reaches the network only through the
      simulator, the promotion gate and the exam, and never as a labelled training example. This page places that
      choice among the other ways to build models from physics and data, and asks where the line could move.
    </p>
    <dl class="stats">
      <div><dt class="kicker">models</dt><dd class="num">{s.models}</dd></div>
      <div><dt class="kicker">real labelled training examples</dt><dd class="num real-t">{s.realTrainingLabels}</dd></div>
      <div><dt class="kicker">rung decisions logged</dt><dd class="num">{s.rungs}</dd></div>
      <div><dt class="kicker">of them rejections</dt><dd class="num">{s.rejected}</dd></div>
    </dl>
  </section>

  <nav class="toc" aria-label="On this page">
    <div class="wrap toc-in">
      {toc.map(([id, t], i) => <a href={`#${id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span> {t}</a>)}
    </div>
  </nav>

  <section class="sec wrap" id="first-guess">
    <header class="sec-head reveal">
      <p class="kicker">01 · Baseline</p>
      <h2 class="section">A common first guess, <em>marked up</em></h2>
      <p class="muted">A common first reading of this project goes: build physics simulations of an area, produce data, find real data, train a model on it. Most of that holds. One clause is wrong, and three steps are missing.</p>
    </header>
    <div class="frame diff-box">
      <p class="diff">
        {GUESS_DIFF.map((d, i) => (
          <>{d.k === 'del' ? <del>{d.t}</del> : d.k === 'ins' ? <ins>{d.t}</ins> : <span class="ok">{d.t}</span>}{i < GUESS_DIFF.length - 1 ? (d.k === 'del' ? ' ' : ', ') : '.'}</>
        ))}
      </p>
      <p class="diff-key mono"><span class="ok">kept</span> <ins>added</ins> <del>struck</del></p>
    </div>
    <ul class="tweaks">
      <li><span class="kicker">Wrong</span><b>Real data as training rows.</b> {s.realTrainingLabels} real labelled examples were used for training. That keeps the exam honest: a network cannot memorise an answer key it never saw. <a href={url('method/')}>The method, step 3</a></li>
      <li><span class="kicker">Missing</span><b>The simulator is checked first.</b> QuakeNet’s synthesis matches EarthScope Syngine at r = 0.9999; RoadSim’s energy ledger closes in all 600 stress runs. <a href={url('method/')}>Step 1</a></li>
      <li><span class="kicker">Missing</span><b>The ratchet.</b> A new version is kept only if it beats the incumbent on a frozen simulated set by a fixed margin and passes a gate on real dev units. Every attempt is logged. <a href="#ratchet">Section 04</a></li>
      <li><span class="kicker">Missing</span><b>Mismatch goes back to physics.</b> When real dev data disagrees with the simulation, the simulator changes, and that measured gap becomes the next rung. <a href={url('story/')}>The story</a></li>
    </ul>
  </section>

  <section class="sec wrap" id="wiring">
    <header class="sec-head reveal">
      <p class="kicker">02 · Compare approaches</p>
      <h2 class="section">Same boxes, <em>different wiring</em></h2>
      <p class="muted">Every physics-plus-ML approach uses the same parts. They differ in which arrows are switched on. Read them as a menu, not a ranking: each fits a different problem, and a model here can borrow one when its evidence points that way. Pick one and watch where <span class="real-t">real data</span> and <span class="sim-t">simulated data</span> go.</p>
    </header>
    <WiringDiagram approaches={approaches} start="repo" nodeInfo={nodeInfo} edgeInfo={edgeInfo} />
    <p class="note faint">The nine other approaches are general practice, each with one or two published references; the lines about this repository are read from its files.</p>
  </section>

  <section class="sec wrap" id="grey-box">
    <header class="sec-head reveal">
      <p class="kicker">03 · A visitor’s question</p>
      <h2 class="section">Is this physics-informed ML? <em>Yes, in three places.</em></h2>
      <p class="muted">The textbook version of physics-informed ML puts the governing equations in the loss function (a PINN, in section 02). No model here does that. The physics sits upstream of the network and around it.</p>
    </header>
    <div class="grey-grid">
      <div class="frame pad">
        <h3 class="display h3">Where the physics sits</h3>
        <ol class="where">
          <li><b>In the data generator.</b> Every training example comes from governing equations. That is true of all {s.models} models.</li>
          <li><b>In the simulator’s fitted constants.</b> A handful of physical parameters are fitted to real dev data: QuakeNet’s surface waves 6.5% slower than the ak135 Earth model, RoadSim’s engine-oil heat capacity doubled and its base accessory load set to 250 W. This is classic grey-box system identification.</li>
          <li><b>In the shape of inputs and outputs.</b> {count('physics_inputs')} networks read physics-derived features, and {count('physics_anchor')} anchor their output to a physics estimate or decision. EnergyNet’s rung 2 made exactly that switch, and it was kept.</li>
        </ol>
        <p class="muted small">The network’s weights stay a black box. The system around them is grey.</p>
      </div>
      <div class="frame pad" data-grey>
        <div class="grey-head">
          <h3 class="display h3">Per model, from each card</h3>
          <button type="button" class="btn ghost tiny" data-grey-toggle aria-pressed="false">Show what each mark says</button>
        </div>
        <div class="table-scroll">
          <table class="data grey">
            <thead><tr><th>Model</th><th class="c">Real noise or routes under the simulations</th><th class="c">Physics-shaped inputs<sup>*</sup></th><th class="c">Output anchored to physics<sup>*</sup></th><th>Real data’s jobs</th></tr></thead>
            <tbody>
              {grey.map((g) => (
                <tr>
                  <td><a href={url(`models/${g.id}/`)} style={`--c:${g.accent}`} class="mname">{g.name}</a></td>
                  {(['real_backdrop', 'physics_inputs', 'physics_anchor'] as const).map((k) => {
                    const v = g.a?.[k];
                    return (
                      <td class="c">
                        <span class={`dot ${v ? (k === 'real_backdrop' ? 'r' : 's') : 'o'}`} title={v || 'no'}></span>
                        <span class="sr">{v ? `Yes: ${v}` : 'No'}</span>
                        {v && <span class="why" aria-hidden="true">{v}</span>}
                      </td>
                    );
                  })}
                  <td class="roles mono">{g.a ? g.a.real_data_roles.map((r) => ROLE[r]).join(' · ') : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="foot faint">
          Generated from the <code>approach</code> block of each <a href={ghFile('docs/model-contract.md')}>model.yaml</a>.
          An empty ring means the card does not claim it. Every model is trained on simulations only.<br />
          <sup>*</sup> These two columns are judgement calls, read from each model’s inference code and card. Not yet independently reviewed.
        </p>
      </div>
    </div>
  </section>

  <section class="sec wrap" id="ratchet">
    <header class="sec-head reveal">
      <p class="kicker">04 · The mechanism</p>
      <h2 class="section">The ratchet, <em>from the logs</em></h2>
      <p class="muted">Each model keeps its ladder in <code>ratchet.yaml</code>. A rung is kept only if it clears the margin on the frozen simulated set and passes the real dev gate. {s.rungs} decisions so far, {s.rejected} of them rejections.</p>
    </header>
    <div class="frame pad machine-box">
      <p class="kicker mb-head">Every rung decision in the collection, in log order</p>
      <RatchetMachine />
    </div>
    <div class="lad-pick" data-ladpick>
      <p class="kicker">One ladder in full</p>
      <div class="chips-row" role="group" aria-label="Choose a ladder">
        {ladders.map((x, i) => <button type="button" class="lp" data-i={i} aria-pressed={i === startLadder} title={x.l.name}>{x.label}</button>)}
      </div>
      {ladders.map((x, i) => (
        <div class="frame pad lad" data-lad={i} hidden={i !== startLadder}>
          <p class="mono faint lad-meta">{x.l.rungs.length} rungs · {x.l.rungs.filter((r) => r.decision === 'rejected').length} rejected{x.l.scored_on ? ` · scored on ${x.l.scored_on}` : ''}</p>
          <p class="lad-rule">{x.l.rule}</p>
          {x.groups.length > 0 && (
            <div class="rej">
              <p class="kicker">Why each rejected rung was rejected</p>
              <ul class="rej-list">
                {x.groups.map((g) => (
                  <li class={`rg rg-${g.k}`}>
                    <span class="rg-k">{REJECT_LABEL[g.k]}</span>
                    {g.rungs.map((r) => <span class="rid-tag num" title={r.why}>{r.id}</span>)}
                  </li>
                ))}
              </ul>
              {x.gateUp.length > 0 && (
                <p class="rej-note">
                  {x.gateUp.length === 1 ? `${x.gateUp[0].id} scored` : `${idRange(x.gateUp.map((r) => r.id))} each scored`} higher than the
                  incumbent on the frozen simulated set and {x.gateUp.length === 1 ? 'was' : 'were'} still rejected: {x.gateUp.length === 1 ? 'it' : 'each'} read
                  the real dev units worse than the gate allows. A gain that shows only in simulation does not count. That is the
                  ratchet working as intended.
                </p>
              )}
            </div>
          )}
          <LadderChart ladder={x.l} accent={x.m.accent} uid={x.uid} />
        </div>
      ))}
      <p class="note faint">Scores are as logged. Some ladders changed frozen set or rule part-way, so a kept rung can sit below an earlier rejected one; each rung’s reason says why.</p>
    </div>
  </section>

  <section class="sec wrap" id="worked-example">
    <header class="sec-head reveal">
      <p class="kicker">05 · Worked example · RoadSim v2 → v2.1, 14 Nov 2026</p>
      <h2 class="section">The ratchet, <em>applied to a simulator</em></h2>
      <p class="muted">No network was trained in this example. RoadSim, the shared vehicle simulator, went through rungs of its own. Each was fitted on dev data only, and a fresh exam was frozen before any fitting began. RoadSim has moved on since; its current state is on the <a href={url('vehicle/')}>vehicle platform</a> page.</p>
      <p class="faint small gloss"><b>Terms.</b> FTP and HWFET: the EPA's city and highway test cycles, driven on a
        dynamometer. Exam-2: RoadSim's second frozen exam set. VED: the Vehicle Energy Dataset, real trips logged in
        Ann Arbor in 2017–18. D3: Argonne's Downloadable Dynamometer Database. H11–H20: RoadSim's own calibration rungs.
        P0/P1, P2: where a hybrid's motor sits (on the engine's belt or crankshaft; between the engine and the gearbox).
        TMED: Hyundai and Kia's P2 hybrid drive. Power-split: the planetary-gear layout Toyota and Ford use. e:HEV:
        Honda's hybrid, which mostly drives on its motor. CS: charge-sustaining, a plug-in running on a held battery charge
        like an ordinary hybrid.</p>
    </header>
    <ol class="timeline">
      <li class="frame"><span class="kicker">13 Nov · physics v2</span><h3 class="display">Frozen, made the default</h3><p>The conventional city and highway bias was fixed (held-out FTP +0.4%, HWFET −1.9%). The three released models stayed pinned to v1 until they were rebuilt.</p></li>
      <li class="frame"><span class="kicker">14 Nov · commit b2f10c0</span><h3 class="display">Exam-2 frozen first</h3><p>The v2 held-out results had already been seen, so they could judge nothing new. A fresh set was fixed before fitting: 409 unseen EPA hybrid records and 108 VED exam cars.</p></li>
      <li class="frame"><span class="kicker">14 Nov · commit 1896a7d</span><h3 class="display">v2.1 frozen on dev</h3><p>One change kept: the engine runs on for 2 s into braking, the median measured on six D3 dev hybrids.</p>
        <p class="pills"><span class="pill kept">H13 kept</span>{['H12', 'H14', 'H15', 'H17', 'H18–19', 'H20'].map((h) => <span class="pill rej">{h}</span>)}</p></li>
      <li class="frame"><span class="kicker">14 Nov · commit 39f5e53</span><h3 class="display">Report, computed once</h3><p>Engine behaviour improved. Fuel errors moved by 0.1 to 2.5 points, mostly toward zero. The large hybrid errors remained, so v2 stayed the default.</p></li>
    </ol>
    <div class="frame pad">
      <h3 class="display h3">Exam-2: city-cycle fuel-economy error on fresh EPA hybrids</h3>
      <p class="faint small">Median FTP error, %. Positive = the simulation burns less than the real car. Hollow = v2, solid = v2.1. n = records with an FTP result.</p>
      <Exam2Chart />
      <p class="verdict">On VED roads the Toyota-type engine-on gap closed from −10.1 to −3.8 points. On the dyno the dots barely move. Older Toyota and Lexus power-splits read 17% too frugal, converter P2s 26%, plug-in series 19%. A hand-built physics fix pass stopped paying on these groups; section 07 uses that as one of its signals.</p>
      <p class="foot faint">Source: <a href={ghFile('shared/vehicle/roadsim/LIMITS.md')}>shared/vehicle/roadsim/LIMITS.md</a> (exam-2) and <a href={ghFile('shared/vehicle/roadsim/CALIBRATION.md')}>CALIBRATION.md</a> (rungs H11–H20).</p>
    </div>
  </section>

  <section class="sec wrap" id="lenses">
    <header class="sec-head reveal">
      <p class="kicker">06 · Ways to hold it in mind</p>
      <h2 class="section">Eight <em>lenses</em></h2>
      <p class="muted">Each lens explains part of the method and hides another part. The first is the common first guess from section 01; the third is the smallest step on from it. The names and framings are this page’s own. The evidence lines come from the repository.</p>
    </header>
    <Lenses lenses={lenses} start={2} />
  </section>

  <section class="sec wrap" id="real-data">
    <header class="sec-head reveal">
      <p class="kicker">07 · An explainer, with possible directions</p>
      <h2 class="section">Why no real training data, <em>and where that line could move</em></h2>
      <p class="muted">The no-real-labels rule keeps the exam meaningful, and it has a cost: where a simulator cannot reach, real data could help. How far real data reaches is a dial with seven stops. Stops 0 to 2 describe this repository today. Stops 3 to 6, the signals and the recipe below are possible directions, not plans; the <a href={url('backlog/')}>backlog</a> lists the idea.</p>
    </header>
    <RealDataDial stops={stops} start={2} />
    <div class="grid2">
      <div class="frame pad">
        <h3 class="display h3">Signals that a stop past 2 would pay</h3>
        <ul class="ticks">
          <li><b>A regression trained on real data beats the network.</b> {hwy ? <>EnergyNet {energy.version} loses EPA petrol highway to a log-linear regression, {pct(hwy.model)}% against {regVal(hwy)}%.</> : <>EnergyNet loses some EPA petrol rows to a log-linear regression.</>} Real data holds information the simulation lacks there.</li>
          <li><b>Physics fix passes stop paying.</b> RoadSim v2.1 kept one change and rejected the rest, and exam-2 shows the large hybrid errors unchanged.</li>
          <li><b>The gap is structured, but not in any available spec.</b> Per-engine spread comes from using one of ten benchmark maps per engine. Fitting per-map levels was tried and rejected (rung C3b): it matched the EPA pool and made every metered D3 car worse.</li>
          <li><b>The labels are measured and can be split by unit.</b> Argonne’s D3 holds 1,661 usable dynamometer traces from 65 vehicles, with measured fuel. The EPA test-car lists hold 80,227 tests.</li>
        </ul>
        <h3 class="display h3 mt">Signals to wait</h3>
        <ul class="ticks wait">
          <li><b>The labels are estimates.</b> VED fuel is inferred from mass air flow or engine load for 351 of 384 vehicles. A network trained on those labels learns the estimator’s bias.</li>
          <li><b>The twin test still points at something nameable.</b> If simulated twins read right and real units read wrong for a reason that can be stated, a simulator rung is cheaper and keeps the claim.</li>
          <li><b>Few distinct units.</b> A small dev set was too kind once already: BearingNet scored 0.78 on its Paderborn dev files and 0.45 on the exam.</li>
        </ul>
      </div>
      <div class="frame pad">
        <h3 class="display h3">One way it could be done, keeping the ratchet honest</h3>
        <p class="kicker possible">A possible direction · not planned work</p>
        <ol class="recipe">
          <li>Cut a third real split, <b>real-train</b>, by vehicle or family, frozen with a hash like the existing <code>splits.json</code>. Dev and exam stay untouched.</li>
          <li>Keep the simulation-only model as its own ladder. Start a second ladder for simulation plus real. Publish both columns side by side.</li>
          <li>Apply the same rule to both: beat the incumbent on the frozen set by the margin, pass the dev gate, log every rung.</li>
          <li>Move in dial order. Try unlabelled real inputs (stop 3) and a learned discrepancy term (stop 4) before fine-tuning on labels (stop 5). Each earlier stop keeps more of the claim.</li>
          <li>Keep the real-trained regression as a baseline on every exam row. The simulation-plus-real model has to beat it to count as a win.</li>
        </ol>
        <p class="verdict">The difference between the two columns becomes a measurement in its own right: how much reality adds on top of physics, per fleet and per cycle.</p>
      </div>
    </div>
  </section>

  <section class="sec wrap" id="neighbours">
    <header class="sec-head reveal">
      <p class="kicker">08 · How it compares</p>
      <h2 class="section">Neighbours, <em>and where this one differs</em></h2>
      <p class="muted">A sample of related projects, not a survey. <b class="dir-forward">Forward</b> projects run a simulator’s direction, from cause to signal; <b class="dir-inverse">inverse</b> ones run from a real signal back to its cause, as the models here do. The tag under each name switches the section 02 diagram to that wiring.</p>
    </header>
    <ul class="nbrs">
      {NEIGHBOURS.map((n) => (
        <li class="frame nbr reveal">
          <p class="nbr-top">
            <span class={`dir dir-${n.dir}`}>{n.dir === 'forward' ? 'Forward' : n.dir === 'inverse' ? 'Inverse' : 'Tools for agents'}</span>
            {n.open && <span class="mono faint lic">{n.open}</span>}
          </p>
          <h3 class="display nbr-name"><a href={n.url} rel="noopener">{n.name}</a></h3>
          {n.who && <p class="mono faint nbr-who">{n.who}</p>}
          {n.ap ? <a class="ap-tag" href="#wiring" data-pick={n.ap}>{n.apLabel} →</a> : <span class="ap-tag plain">{n.apLabel}</span>}
          <p class="nbr-what">{n.what}</p>
          <p class="nbr-vs"><span class="kicker">Next to this repository</span>{n.vs}</p>
        </li>
      ))}
    </ul>
    <div class="frame pad nbr-sum reveal">
      <p>Most of the field runs simulators <b>forward</b>: a network learns to give a simulator’s answer faster than the simulator can. The networks here run the other way, from a real instrument record back to its cause, as sbi and DINGO do.</p>
      <p>What this repository adds is one grading protocol carried across unrelated fields: zero real labels in training, every rung logged, one exam on real data beside classical baselines, and the losses published. Inside its own field, each specialist project goes much further than the matching model here; DINGO next to ChirpNet is the clearest case.</p>
    </div>
    <p class="note faint">Each line above was checked against the project’s own page or paper on 15 Nov 2026. Funding and company figures are left out on purpose.</p>
  </section>

  <section class="sec wrap close" id="many-ways">
    <header class="sec-head reveal">
      <p class="kicker">Close</p>
      <h2 class="section">Many ways to build a model. <em>One way to judge a change.</em></h2>
    </header>
    <div class="close-body reveal">
      <p>Each wiring in section 02 fits some problem better than the rest, and none of them is right everywhere, this repository’s own included. The collection uses one recipe today because, for every model in it, a credible simulator could be built and real labels were scarce or untrustworthy. Where that stops being true for a model, it can borrow another approach: a learned residual, a discrepancy term, a fine-tuned second ladder.</p>
      <p>The method can change when the evidence says so. The ratchet is how a change gets judged. A new approach enters as a rung, with its pass mark fixed before the result is seen, and the result is logged either way. A kept rung changes the method for that model. A rejected one stays in the log, so the next attempt starts from what it showed.</p>
    </div>
  </section>

  <section class="wrap sources">
    <p class="kicker">Sources and status</p>
    <p class="faint small">
      Built from the repository: README.md, <a href={url('method/')}>docs/method.md</a>, <a href={url('lessons/')}>docs/lessons.md</a>,
      <a href={url('vehicle/')}>docs/vehicle-platform.md</a>, every <code>models/*/model.yaml</code> (including its <code>approach</code> block) and
      <code>ratchet.yaml</code>, and <code>shared/vehicle</code> (roadsim/CALIBRATION.md, roadsim/LIMITS.md, data/DATA.md, data/D3.md).
      Counts and EnergyNet’s exam numbers are read at build time. Section 02’s other approaches are general practice, with
      references. Section 06’s lens names are this page’s framing. Section 07’s stops 3 to 6, its signals and its recipe are
      possible directions; nothing in the repository commits to them. Reading RoadSim’s 700 W on-road term as a discrepancy
      term is an interpretation of CALIBRATION.md rung C6.
    </p>
    <div class="next">
      <a class="btn" href={url('method/')}>The method, step by step <span class="arrow">→</span></a>
      <a class="btn ghost" href={url('story/')}>The story: one model, one record</a>
      <a class="btn ghost" href={url('model-families/')}>Model families: which learner fits which problem</a>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-ladpick]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.lp')];
    const lads = [...root.querySelectorAll<HTMLElement>('[data-lad]')];
    btns.forEach((b, i) => b.addEventListener('click', () => {
      btns.forEach((x, j) => x.setAttribute('aria-pressed', String(i === j)));
      lads.forEach((l, j) => (l.hidden = i !== j));
      lads[i].querySelector('.chart')?.classList.add('in');
    }));
  });
  // a neighbour's approach tag switches the wiring diagram to that approach
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => a.addEventListener('click', () => {
    document.querySelector('[data-wiring]')?.dispatchEvent(new CustomEvent('mm-pick', { detail: a.dataset.pick }));
  }));
  document.querySelectorAll<HTMLElement>('[data-grey]').forEach((root) => {
    const b = root.querySelector<HTMLButtonElement>('[data-grey-toggle]')!;
    b.addEventListener('click', () => {
      const on = root.classList.toggle('show-why');
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? 'Hide the details' : 'Show what each mark says';
    });
  });
</script>

