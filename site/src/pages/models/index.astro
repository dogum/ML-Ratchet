---
import Base from '../../layouts/Base.astro';
import ModelCard from '../../components/ModelCard.astro';
import { getModels } from '../../lib/data';
import { url } from '../../lib/url';
const models = getModels();
const domains = [...new Set(models.map((m) => m.domain))];
---
<Base title="Models" description="Every model in ML Ratchet: what it reads, what it returns, and how it did on its real exam.">
  <section class="wrap head">
    <p class="kicker tick-label">The collection</p>
    <h1 class="display h">Nine models.<br /><em>Zero real labels.</em></h1>
    <p class="muted lead">Each learned only from simulated physics, climbed a logged ratchet, and sat one real exam beside a classical method and a dumb baseline. Filter by field:</p>
    <div class="filters" role="group" aria-label="Filter by field">
      <button type="button" class="f on" data-f="all">All <span class="num">{models.length}</span></button>
      {domains.map((d) => <button type="button" class="f" data-f={d}>{d} <span class="num">{models.filter((m) => m.domain === d).length}</span></button>)}
    </div>
  </section>
  <section class="wrap grid">
    {models.map((m, i) => <div class="cell" data-domain={m.domain}><ModelCard m={m} index={i} /></div>)}
  </section>
  <section class="wrap table-sec">
    <h2 class="section">At a glance</h2>
    <div class="table-scroll">
      <table class="data">
        <thead><tr><th>Model</th><th>Field</th><th>Reads</th><th class="num">Rungs</th><th class="num">Rejected</th><th class="num">Exam W / L</th><th>Status</th></tr></thead>
        <tbody>
          {models.map((m) => (
            <tr style={`--c:${m.accent}`}>
              <td><a class="mname" href={url(`models/${m.id}/`)}>{m.name}</a> <span class="faint num">v{m.version}</span></td>
              <td>{m.domain}</td>
              <td class="reads">{m.reads}</td>
              <td class="num">{m.rungCount}</td>
              <td class="num">{m.rejectedCount}</td>
              <td class="num">{m.tally.win} / {m.tally.loss}</td>
              <td class="mono st">{m.status === 'partial' ? 'exam partly pending' : m.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.f');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('.cell').forEach((c) => {
      c.hidden = b.dataset.f !== 'all' && c.dataset.domain !== b.dataset.f;
    });
  }));
</script>
<style>
  .head { padding-top: clamp(40px, 7vw, 90px); }
  .h { font-size: clamp(56px, 9vw, 128px); margin: 16px 0 24px; letter-spacing: -0.035em; }
  .h em { color: var(--ink-2); }
  .lead { max-width: 60ch; font-size: 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 30px; }
  .f { font-family: var(--mono); font-variation-settings: 'wdth' 87.5; font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; padding: 8px 12px; border: 1px solid var(--rule); background: var(--paper-3); color: var(--ink-2); border-radius: 99px; cursor: pointer; }
  .f span { color: var(--ink-3); margin-left: 4px; }
  .f.on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cell > :global(a) { height: 100%; }
  .table-sec { margin-top: 100px; }
  .table-sec .section { margin-bottom: 24px; }
  .mname { font-family: var(--display); font-size: 24px; text-decoration: none; color: var(--c); }
  .reads { color: var(--ink-2); font-size: 13.5px; max-width: 42ch; }
  .st { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
  @media (max-width: 1020px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
