shared/vehicle/checks/ved_twin_exam2__*.json

# Grid platform: rebuildable data (scripts in shared/grid/data/scripts, sources in DATA.md; `mlratchet data grid`).
# Only the frozen split file and the manifest of shipped hashes are tracked.
shared/grid/data/raw/
shared/grid/data/work/
shared/grid/data/proc/*
!shared/grid/data/proc/splits.json
shared/grid/gridsim/refdata/
shared/grid/checks/out/
shared/grid/gridsim/logs/
shared/grid/gridsim/.refenv/
