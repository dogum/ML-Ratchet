# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Training work folders: downloads, banks, checkpoints, figures, release builds
models/*/work/
work/

# Training artefacts that should never be committed
*.pt
*.ckpt
*.resume

# Site
site/node_modules/
site/dist/
site/.astro/
site/public/models/
site/src/generated/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Source archives this repo was assembled from
/*.zip

# Local agent / editor config
.claude/

# Vehicle platform: rebuildable data (scripts in shared/vehicle/data/scripts; sources in DATA.md)
shared/vehicle/data/raw/
shared/vehicle/data/proc/ved/
shared/vehicle/data/proc/ved_*/
shared/vehicle/data/proc/splits_ved_part*
shared/vehicle/data/proc/dem_*/
shared/vehicle/roadsim/refdata/
shared/vehicle/roadsim/logs/
# VED exam-2 per-trip twin results (VED exam is the models' exam too: summaries only are tracked, in exam2_report.json and the scoreboards)
shared/vehicle/checks/ved_twin_exam2__*.json

# Grid platform: rebuildable data (scripts in shared/grid/data/scripts, sources in DATA.md; `mlratchet data grid`).
# Only the frozen split file and the manifest of shipped hashes are tracked.
shared/grid/data/raw/
shared/grid/data/work/
shared/grid/data/proc/*
!shared/grid/data/proc/splits.json
shared/grid/gridsim/refdata/
shared/grid/checks/out/
shared/grid/gridsim/logs/
shared/grid/gridsim/.refenv/

# Building platform: rebuildable data (scripts in shared/building/data/scripts, sources in DATA.md;
# `mlratchet data building`). Tracked under data/: DATA.md, scripts/, build.py, MANIFEST.json and the frozen
# proc/splits.json. TMYx/EPW weather and the priors live in buildingsim/refdata/ (not ours to commit; rebuildable).
shared/building/data/*
!shared/building/data/DATA.md
!shared/building/data/scripts/
!shared/building/data/build.py
!shared/building/data/MANIFEST.json
!shared/building/data/proc/
shared/building/data/proc/*
!shared/building/data/proc/splits.json
shared/building/buildingsim/refdata/
shared/building/buildingsim/.refenv/
shared/building/buildingsim/tmp/
shared/building/checks/out/

# Water platform: rebuildable data (scripts in shared/water/data/scripts, sources in waterdata/DATA.md;
# `mlratchet data water`). Tracked under data/: scripts/, build.py, MANIFEST.json and the frozen proc/splits.json.
# checks/ref/*.csv are airGR/TUWmodel example inputs and reference outputs (from GPL R packages; not redistributed).
shared/water/data/*
!shared/water/data/scripts/
!shared/water/data/build.py
!shared/water/data/MANIFEST.json
!shared/water/data/proc/
shared/water/data/proc/*
!shared/water/data/proc/splits.json
shared/water/checks/out/
shared/water/checks/ref/*.csv
shared/water/watersim/.refenv/
shared/water/watersim/tmp/
shared/water/watersim/pids/

# Fire platform: rebuildable data (scripts in shared/fire/data/scripts, sources in data/DATA.md; `mlratchet data fire`).
# Tracked under data/: DATA.md, scripts/, build.py, MANIFEST.json and the frozen proc/splits.json.
# firesim/refdata/ holds the USFS GTR PDFs and their text (39 MB, public domain): unpacked by --from-zip, not committed.
shared/fire/data/*
!shared/fire/data/DATA.md
!shared/fire/data/scripts/
!shared/fire/data/build.py
!shared/fire/data/MANIFEST.json
!shared/fire/data/proc/
shared/fire/data/proc/*
!shared/fire/data/proc/splits.json
shared/fire/checks/out/
shared/fire/firesim/refdata/
shared/fire/firesim/demo_out/
shared/fire/firesim/.refenv/
shared/fire/firesim/tmp/
shared/fire/firesim/pids/

# Bake-off exam per-unit scores (194 MB): release zip only, not in git (see experiments/bakeoff-vehicle/README.md)
experiments/bakeoff-vehicle/results/exam_*/scores.parquet
# TabPFN third-party code and weights (Prior Labs License 1.1; restore with pip / Hugging Face, see the arm card)
experiments/bakeoff-vehicle/arms_table/tab_tabpfn/pylib/
experiments/bakeoff-vehicle/arms_table/tab_tabpfn/weights/
# Supplementary exams: per-record predictions, rehearsals and access logs stay local
experiments/bakeoff-vehicle/results/supp_*/exam_*/preds/
experiments/bakeoff-vehicle/results/supp_*/rehearsal_*
experiments/bakeoff-vehicle/results/supp_*/exam_access.log
