{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dogum/ML-Ratchet/mlratchet/schema/ratchet.schema.json",
  "title": "ML Ratchet ladder (ratchet.yaml)",
  "description": "Every rung a model tried, kept or not, with the reason. Raw per-rung logs stay in training/.",
  "type": "object",
  "required": ["model", "ladders"],
  "additionalProperties": false,
  "properties": {
    "model": { "type": "string" },
    "ladders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "objective", "rule", "margin", "rungs"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "objective": { "type": "string", "description": "What is scored on the frozen simulated set" },
          "rule": { "type": "string", "description": "When a rung is kept" },
          "margin": { "type": "number" },
          "dev_gate": { "type": "string" },
          "frozen_sets": { "type": "array", "items": { "type": "string" } },
          "scored_on": { "type": "string" },
          "note": { "type": "string" },
          "columns_source": { "type": "string", "description": "Where the per-rung metric columns come from" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rungs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "change", "decision", "why"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "change": { "type": "string" },
                "sim": { "type": "number" },
                "dev": { "type": "object" },
                "decision": { "enum": ["kept", "rejected", "released"] },
                "why": { "type": "string" },
                "metrics": { "type": "array", "items": { "type": ["number", "string"] } }
              }
            }
          }
        }
      }
    }
  }
}
